# For Playwright E2E tests only (e2e/, playwright.config.ts) — never read
# by the app itself. Copy to `.env` (gitignored) and fill in real values.
#
# CLERK_SECRET_KEY is a real secret — Clerk Dashboard → Configure → API
# Keys → "Secret keys". Do not put it in src/environments/ (that ships to
# the browser); it's only ever read by Node-side Playwright setup code.
CLERK_SECRET_KEY=sk_test_...
# The same publishable key already hardcoded in
# src/environments/environment.ts — repeated here because @clerk/testing
# reads it from the environment, not from that file.
CLERK_PUBLISHABLE_KEY=pk_test_...

# Must be an EXISTING user in this Clerk instance with Email/Password auth
# enabled. The "+clerk_test" tag is Clerk's convention for suppressing real
# email delivery to test addresses — see
# https://clerk.com/docs/guides/development/testing/playwright/overview
E2E_CLERK_USER_EMAIL=e2e+clerk_test@example.com
