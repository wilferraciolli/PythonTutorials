{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "fastapi-cloudflare-ai",
	"main": "src/entry.py",
	// Set this to today's date when you first deploy
	"compatibility_date": "2026-09-23",
	"compatibility_flags": ["python_workers"],
	"vars": {
		"CLERK_JWKS_URL": "https://one-python-4861.clerk.accounts.dev/.well-known/jwks.json",
		"CLERK_AUDIENCE": "wiltech-dev-api",
		"CF_AI_MODEL": "@cf/meta/llama-3.1-8b-instruct",
		"GROQ_BASE_URL": "https://api.groq.com/openai/v1",
		"GROQ_MODEL": "openai/gpt-oss-20b"
	},
	// Secret, not a var: `npx wrangler secret put GROQ_API_KEY`
	"ai": {
		"binding": "AI"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "wiltech-db",
			"database_id": "1160bc57-4a89-42cb-88ec-a8aea4ba6585"
		}
	]
}
