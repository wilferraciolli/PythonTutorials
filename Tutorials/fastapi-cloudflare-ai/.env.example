# Local uvicorn/Docker mode
DATABASE_MODE=sqlite
DATABASE_PATH=./local.db

# Cloudflare Worker mode normally uses the D1 binding from wrangler.jsonc.
# Leave DATABASE_MODE unset in deployed Workers, or set:
# DATABASE_MODE=d1_binding

# Optional non-Worker mode for using Cloudflare D1 over HTTP from another host.
# DATABASE_MODE=d1_http
# CF_ACCOUNT_ID=...
# CF_D1_DATABASE_ID=...
# CF_D1_API_TOKEN=...

# Workers AI — portable HTTP mode (works from local uvicorn/Docker, any
# non-Worker host, or a Cloudflare Worker). Needs a Cloudflare API token
# scoped to Workers AI.
AI_MODE=http
CF_ACCOUNT_ID=...
CF_AI_API_TOKEN=...

# Cloudflare Worker mode can use the native env.AI binding from
# wrangler.jsonc instead (no token needed). Leave AI_MODE unset in deployed
# Workers to prefer it automatically, or set it explicitly:
# AI_MODE=binding

# Clerk authentication
CLERK_JWKS_URL=https://one-python-4861.clerk.accounts.dev/.well-known/jwks.json
CLERK_AUDIENCE=wiltech-dev-api

# Optional comma-separated frontend origins. When configured, the token's
# `azp` claim must match one of these values.
# CLERK_AUTHORIZED_PARTIES=http://localhost:4200,https://app.example.com
