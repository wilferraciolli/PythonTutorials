{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "fastapi-template",
	"main": "src/entry.py",
	// Set this to today's date when you first deploy
	"compatibility_date": "2026-09-23",
	"compatibility_flags": ["python_workers"],
	"vars": {
		"CLERK_JWKS_URL": "https://one-python-4861.clerk.accounts.dev/.well-known/jwks.json",
		"CLERK_AUDIENCE": "wiltech-dev-api"
	}
	// Add bindings here as a new project needs them, e.g. Cloudflare D1
	// (database.py already supports it via DATABASE_MODE=d1_binding):
	// "d1_databases": [
	//   {
	//     "binding": "DB",
	//     "database_name": "<name>",
	//     "database_id": "<id>"
	//   }
	// ]
}
