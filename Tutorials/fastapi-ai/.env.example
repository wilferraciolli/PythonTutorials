# Database - sqlite | d1_http
DATABASE_MODE=sqlite

# Database Local
DATABASE_PATH=./local.db

# Database Cloudflare D1
CF_D1_ACCOUNT_ID=
CF_D1_DATABASE_ID=
CF_D1_API_TOKEN=

# Frontend origins allowed by CORS (comma-separated)
CORS_ORIGINS=http://localhost:4200,http://localhost:4201

# AI
AI_MODE=http

# Cloudflare Workers AI
CF_AI_ACCOUNT_ID=
CF_AI_API_TOKEN=
CF_AI_MODEL=@cf/meta/llama-3.1-8b-instruct
# Embedding model for chat search (768 dimensions)
CF_EMBEDDING_MODEL=@cf/baai/bge-base-en-v1.5

# Groq AI
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b

# Post media (docs/social-groups.md "Post media"). Giphy's key lives in the
# showcase's src/environments (it's searched from the browser); YouTube needs none.
# Unsplash: https://unsplash.com/oauth/applications (only the access key is used; the secret is for OAuth)
UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=

# Clerk
CLERK_JWKS_URL=https://one-python-4861.clerk.accounts.dev/.well-known/jwks.json
CLERK_AUDIENCE=wiltech-dev-api
